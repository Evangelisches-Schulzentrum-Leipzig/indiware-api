{
  "name": "timetable-openapi",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAPI for our Timetable (Vertretungsplan) data.",
  "license": "OSL 3.0",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "npm run build:schema && npm run build:ts",
    "build:schema": "typescript-json-schema --noExtraProps --required --strictNullChecks -o ./dist/query/xmljsonschema.json ./src/query/xmlschema.ts VpMobilXmlFileSchema",
    "build:ts": "tsc",
    "dev": "npm run build && npm run start",
    "start": "node ./dist/api.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "mariadb": "^3.2.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-json-schema": "^0.67.1"
  }
}
