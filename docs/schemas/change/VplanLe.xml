<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- VplanLe.xml - Teacher Change Plan Template (Vertretungsplan Lehrer) -->
<vp>
    <kopf>
        <!-- Filename format: VplanLe{YYYYMMDD}.xml -->
        <datei>VplanLeYYYYMMDD.xml</datei>
        <!-- Day name, date with trailing space -->
        <titel>Weekday, D. Month YYYY </titel>
        <!-- School name -->
        <schulname>School Name</schulname>
        <!-- Timestamp when plan was generated: DD.MM.YYYY, HH:mm -->
        <datum>dd.mm.YYYY, hh:mm</datum>
        <kopfinfo>
            <!-- Absent teachers (semicolon-separated) -->
            <abwesendl>Teacher1; Teacher2; ...</abwesendl>
            <!-- Teachers with changes (semicolon-separated) -->
            <aenderungl>Teacher1; Teacher2; ...</aenderungl>
            <!-- Classes with changes (comma-separated) -->
            <aenderungk>Class1, Class2, ...</aenderungk>
        </kopfinfo>
    </kopf>
    <freietage>
        <!-- Free days in YYMMDD format -->
        <ft>YYMMDD</ft>
        ...
    </freietage>
    <aufsichten>
        <!-- Supervision duty changes -->
        <aufsichtzeile>
            <!-- Format: "HH:mm: DutyName - Location --> NewTeacher (für OldTeacher)" -->
            <!-- Or: "HH:mm: DutyName - Location --> entfällt (für OldTeacher)" for cancelled -->
            <aufsichtinfo>HH:mm: DutyName - Location --&gt; NewTeacher (für OldTeacher)</aufsichtinfo>
        </aufsichtzeile>
        ...
    </aufsichten>
    <haupt>
        <!-- Main substitution entries for teachers -->
        <aktion>
            <!-- Period number, can be range like "3-4" or single like "1" -->
            <stunde>N</stunde>
            <!-- Original subject code (empty if cancelled) -->
            <fach>SubjectCode</fach>
            <!-- Original teacher code (empty if cancelled) -->
            <lehrer>TeacherCode</lehrer>
            <!-- Class or course identifier, can include course info like "9e/ inf1" -->
            <klasse>ClassName</klasse>
            <!-- Substitute subject code -->
            <!-- @fageaendert="ae" when subject changed -->
            <vfach fageaendert="ae">SubjectCode</vfach>
            <!-- Substitute teacher code -->
            <!-- Format "(TeacherCode)" indicates original teacher (in parentheses for cancelled) -->
            <!-- @legeaendert="ae" when teacher changed -->
            <vlehrer legeaendert="ae">TeacherCode</vlehrer>
            <!-- Substitute room -->
            <!-- @rageaendert="ae" when room changed -->
            <vraum rageaendert="ae">RoomCode</vraum>
            <!-- Additional info text - Common patterns: -->
            <!-- "fällt aus" - lesson cancelled -->
            <!-- "für {Subject} {Teacher}" - substituting for (e.g., "für REL Wen") -->
            <!-- "verlegt nach St.{N}" - moved to period N -->
            <!-- "verlegt von St.{N}; {Subject} {Teacher} fällt aus" - moved from period, original cancelled -->
            <!-- "selbst./siehe itslearning" - self-study via online platform -->
            <!-- "selbst./siehe itslearning, zu Hause bearbeiten" - self-study at home -->
            <!-- "gehalten am {Day} ({DD.MM.}) St.{N}" - lesson already held (e.g., "gehalten am Mo (05.01.) St.5") -->
            <!-- "alle in {Room}" - all students in specific room (e.g., "alle in 1.18") -->
            <!-- "Projekt" - project work -->
            <!-- Can be empty string -->
            <info>Additional information</info>
        </aktion>
        ...
    </haupt>
    <klausuren>
        <!-- Exam entries -->
        <klausur>
            <!-- Grade level (e.g., 11, 12) -->
            <jahrgang>GradeLevel</jahrgang>
            <!-- Course identifier -->
            <kurs>CourseCode</kurs>
            <!-- Course teacher -->
            <kursleiter>TeacherCode</kursleiter>
            <!-- Period when exam takes place -->
            <stunde>N</stunde>
            <!-- Start time HH:mm -->
            <beginn>HH:mm</beginn>
            <!-- Duration in minutes -->
            <dauer>Minutes</dauer>
            <!-- Exam info (optional) -->
            <kinfo>Exam information</kinfo>
        </klausur>
        ...
    </klausuren>
</vp>